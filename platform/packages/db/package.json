{
  "name": "@somo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:test": "drizzle-kit migrate --config drizzle.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.public-api.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@somo/contracts": "workspace:*",
    "@somo/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10"
  }
}
