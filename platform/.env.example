# Copy this file to .env for local development. Every value below is synthetic.
# Production must use a centralized secret manager and approved provider modules.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=postgresql://somo_test@127.0.0.1:55432/somo_bnpl_test
ALLOWED_ORIGINS=https://customer.test.somo.example
STAFF_COOKIE_NAME=somo_staff_session
COOKIE_SECRET=replace-with-a-local-secret-at-least-32-characters
AUDIT_TARGET_HMAC_SECRET=replace-with-a-local-audit-secret-at-least-32-characters
COOKIE_SECURE=false
BODY_LIMIT_BYTES=10485760
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
STAFF_SESSION_TTL_SECONDS=3600
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
REQUIRE_VERIFIED_MFA=false

# Synthetic development adapters are permitted only outside production.
NIA_ADAPTER=simulator
SMS_ADAPTER=simulator
PAYMENT_ADAPTER=simulator
OBJECT_STORAGE_PUBLIC=false
ENCRYPTION_KEY_REF=local-development-only
BACKUP_LAST_VERIFIED_AT=2099-01-01T00:00:00.000Z
